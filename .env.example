SECRET_KEY=hirehub-dev-secret-key
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=hirehub
UPLOAD_FOLDER=app/uploads/resumes
MAX_CONTENT_LENGTH=5242880
SESSION_LIFETIME_HOURS=12
SESSION_COOKIE_SECURE=false
# Set to true to fail startup instead of using process-local storage if MongoDB is unavailable.
MONGO_REQUIRED=false
